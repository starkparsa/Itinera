# Neon Postgres (free tier, no card -- https://neon.tech). Create a
# project, then Dashboard -> Connection Details -> copy the full URI and
# swap its `postgresql://` prefix for `postgresql+psycopg2://` (SQLAlchemy
# needs the driver named explicitly). Required -- there's no local default;
# see CLAUDE.md's "Database: MySQL -> Postgres on Neon" decision row.
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require
BACKEND_URL=http://localhost:8000
# Comma-separated exact origins allowed to call the backend cross-origin
# (CORS). Defaults to the local Next.js dev server if unset, so local dev
# needs nothing here -- but a real deployment MUST set this explicitly to
# its real frontend origin(s) (e.g. https://app.example.com), or the
# frontend's own Server Actions calls will still work (they're server-side,
# not subject to CORS) but a browser calling the API directly won't be
# allowed to, which is the point. See docs/security-review.md and
# docs/deployment-guide.md §3.1.
ALLOWED_ORIGINS=http://localhost:3000
# Per-account daily cap on POST /trips/generate -- the real per-user cost
# control (distinct from ALLOWED_ORIGINS/CORS above and from the IP-based
# flood protection baked into the backend, see app/rate_limit.py). One flat
# number for every account since there's no pricing/plan tiers yet -- see
# app/usage_quota.py. Optional; defaults to 20/day per account if unset.
DAILY_TRIP_GENERATION_LIMIT=20
GEMINI_API_KEY=Paste your API key here (free, no card -- https://aistudio.google.com/apikey)
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional but recommended: free fallback used only when Gemini's request
# quota is exhausted (see CLAUDE.md decision log). Free, no card, no expiry
# -- get one at https://console.groq.com/keys. Leave blank to disable the
# fallback (Gemini failures will just raise as before).
GROQ_API_KEY=Paste your API key here (free, no card -- https://console.groq.com/keys)

# Optional: unlocks get_place_details/find_nearby_places (current ratings/
# hours/price level, and real nearby-place recommendations) in the QA and
# itinerary-planning tool loops, alongside the existing free Wikipedia
# place-context tool -- see CLAUDE.md's decision log. Unlike every other
# key in this file, this one is BILLED (per Google's Places API (New)
# pricing) and needs a Google Cloud project with billing enabled: Google
# Cloud Console -> APIs & Services -> Library -> enable "Places API (New)"
# -> Credentials -> create an API key. Leave blank to disable both new
# tools -- Wikipedia-only place context continues working exactly as it
# does today, with zero code path change.
GOOGLE_PLACES_API_KEY=

# Optional: unlocks a real per-trip photo on the "Your Trips" cards
# (pexels_service.py). Free tier, no card -- sign up at
# https://www.pexels.com/api/ and copy your key. Leave blank to disable --
# trip cards keep showing today's flat color banner with the destination's
# initials, with zero code path change.
PEXELS_API_KEY=

# Optional: unlocks find_events (real concerts/games/shows) in the QA and
# itinerary-planning tool loops, including building a trip's dates around
# a specific event the user commits to (event_planning.py). Free tier, no
# card -- 5,000 requests/day, confirmed live -- sign up at
# https://developer.ticketmaster.com/products-and-docs/apis/getting-started/
# and copy your Consumer Key (the Consumer Secret is for signed
# Commerce/checkout calls, not used here -- no need to set it). Leave
# blank to disable -- find_events returns {"error": ...} immediately like
# every other optional tool, with zero code path change.
TICKETMASTER_API_KEY=

# Google OAuth (Auth.js) -- only needed for `docker compose up` (it reads
# this root .env directly into both containers' environment; running the
# frontend with `npm run dev` instead reads frontend/.env.local, see its
# .env.local.example). Google Cloud Console -> APIs & Services ->
# Credentials -> OAuth client ID -> Web application. Authorized redirect
# URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# One shared secret, read by both the frontend (signs) and backend
# (verifies, see backend/app/auth.py) -- must be the exact same value in
# both places, or every backend call gets a 401. Generate the same way.
AUTH_BACKEND_SECRET=

# Calendar push (Phase D, backend/app/google_calendar.py) -- lets a
# logged-in user push their itinerary as real Google Calendar events.
# Needs the *same* AUTH_GOOGLE_ID/AUTH_GOOGLE_SECRET above (the backend
# uses them to refresh a stored access token) plus a key to encrypt stored
# tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
