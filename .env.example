# Neon Postgres (free tier, no card -- https://neon.tech). Create a
# project, then Dashboard -> Connection Details -> copy the full URI and
# swap its `postgresql://` prefix for `postgresql+psycopg2://` (SQLAlchemy
# needs the driver named explicitly). Required -- there's no local default;
# see CLAUDE.md's "Database: MySQL -> Postgres on Neon" decision row.
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require
BACKEND_URL=http://localhost:8000
GEMINI_API_KEY=Paste your API key here (free, no card -- https://aistudio.google.com/apikey)
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional but recommended: free fallback used only when Gemini's request
# quota is exhausted (see CLAUDE.md decision log). Free, no card, no expiry
# -- get one at https://console.groq.com/keys. Leave blank to disable the
# fallback (Gemini failures will just raise as before).
GROQ_API_KEY=Paste your API key here (free, no card -- https://console.groq.com/keys)

# Google OAuth (Auth.js) -- only needed for `docker compose up` (it reads
# this root .env directly into both containers' environment; running the
# frontend with `npm run dev` instead reads frontend/.env.local, see its
# .env.local.example). Google Cloud Console -> APIs & Services ->
# Credentials -> OAuth client ID -> Web application. Authorized redirect
# URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# One shared secret, read by both the frontend (signs) and backend
# (verifies, see backend/app/auth.py) -- must be the exact same value in
# both places, or every backend call gets a 401. Generate the same way.
AUTH_BACKEND_SECRET=

# Calendar push (Phase D, backend/app/google_calendar.py) -- lets a
# logged-in user push their itinerary as real Google Calendar events.
# Needs the *same* AUTH_GOOGLE_ID/AUTH_GOOGLE_SECRET above (the backend
# uses them to refresh a stored access token) plus a key to encrypt stored
# tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
