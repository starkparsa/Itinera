# Copy this to .env (same directory as docker-compose.share.yml), fill in
# the values below, then run:
#   docker compose -f docker-compose.share.yml up
#
# Everything below is free, no card required.

# Required. Get one at https://aistudio.google.com/apikey (~1 minute).
GEMINI_API_KEY=

# Optional but recommended -- automatic fallback if Gemini's free-tier
# quota runs out. Get one at https://console.groq.com/keys.
GROQ_API_KEY=

# Leave DATABASE_URL unset to use a local SQLite file (zero setup, no
# account) -- data persists across `docker compose stop`/`start` but is
# lost on `docker compose down -v`. For a real Postgres database instead
# (free tier, no card, at https://neon.tech), uncomment and fill in:
# DATABASE_URL=postgresql://...

# --- Everything below is only needed for real Google sign-in and
# --- "Push to Google Calendar." Without it the app still runs fully --
# --- every sign-in attempt just fails at Google's own consent screen.
#
# Get an OAuth client at https://console.cloud.google.com -> APIs &
# Services -> Credentials -> OAuth client ID -> Web application.
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# (this is always localhost, regardless of whose machine runs it, so a
# single OAuth client set up once works the same way for everyone running
# this compose file on their own machine).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Generate with: openssl rand -base64 32 (or `npx auth secret`)
AUTH_SECRET=

# Must be the SAME value passed to both the backend and frontend services
# -- docker-compose.share.yml already does that for you as long as this
# one value is set here. Generate with: openssl rand -base64 32
AUTH_BACKEND_SECRET=

# Only needed alongside the Google Calendar API being enabled on that same
# Cloud project, for "Push to Google Calendar" specifically. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
